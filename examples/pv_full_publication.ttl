<https://w3id.org/cerise-see/examples/pv-lci#pef-study> a ps:PEFStudy ;
  dcterms:title "PV manufacturing inventory study draft — no verified full footprint"@en ;
  ps:hasGoal <https://w3id.org/cerise-see/examples/pv-lci#goal> ;
  ps:hasScope <https://w3id.org/cerise-see/examples/pv-lci#scope> ;
  ps:hasProductSystem <https://w3id.org/cerise-see/examples/pv-lci#product-system> .

<https://w3id.org/cerise-see/examples/pv-lci#goal> a ps:Goal ;
  ps:intendedApplication "Demonstrate PV manufacturing inventory exchange and demand propagation using the publication ActivityLink, Flow, FlowType and declaring LCIDataset relationships. Exact identities determine suppliers; no FlowLink vocabulary is asserted."^^xsd:string ;
  ps:decisionContext "Research and workshop demonstration only. The user explicitly requested documented demonstration assumptions for the missing background data on 28 October 2026. This scenario is not measured company data, an independently verified LCA, an EPD, an EF-compliant footprint or a basis for comparative assertions. Do not interpret the calculated number as a validated environmental footprint of a real PV panel."^^xsd:string ;
  ps:commissioner <https://w3id.org/cerise-see/examples/pv-lci#commissioner> ;
  ps:verifier <https://w3id.org/cerise-see/examples/pv-lci#verifier> .

<https://w3id.org/cerise-see/examples/pv-lci#commissioner> a foaf:Agent ; foaf:name "CE-RISE PV inventory demonstration (research context; no formal commissioner documented)" .
<https://w3id.org/cerise-see/examples/pv-lci#verifier> a foaf:Agent ; foaf:name "No independent verifier appointed; source and structural checks only" .

<https://w3id.org/cerise-see/examples/pv-lci#scope> a ps:Scope ;
  ps:hasFunctionalUnit <https://w3id.org/cerise-see/examples/pv-lci#functional-unit> ;
  ps:hasSystemBoundary <https://w3id.org/cerise-see/examples/pv-lci#system-boundary> ;
  ps:includesImpactCategory <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#ClimateChange> ;
  ps:hasAssumption "All 404 quantified Excel records and all 391 supplied SD95 values are retained in descriptive source metadata in this file and in structured form in the original master file. Sixteen kWh entries are represented as MJ using the exact physical conversion factor 3.6, with original quantities stored. Twelve original component demands retain their exact FlowTypes and supplier reference-output quantities. The source weighted silicon mix is preserved. Each activity quantity is per its own determining output; upstream demand is propagated using the exact shared FlowType, its declaring dataset and the supplier reference-output quantity. APAC uses the broader ontology geography RAS, with original APAC retained. BONSAI physical kg-to-tonnes and MJ-to-TJ conversions are applied by the calculator. RER backgrounds use explicitly labelled German proxies where no RER offering exists. The 30-year module service-life assumption is contextual only and does not change manufacturing quantities. No source-row cut-off is applied. ORIGINAL FOREGROUND IS UNCHANGED. 29 separate assumed proxy inventories describe candidate supplies for 77 originally unmapped service/product rows; these supplies are now resolved through the publication source-dataset and exact FlowType relationships. All scenario coefficients are explicitly stated per one original reference unit in each proxy activity and flow note. Assumptions include transport service prices (road EUR 0.10/tkm, rail EUR 0.03/tkm, sea EUR 0.01/tkm); coke energy content 28 MJ/kg; water/effluent density 1000 kg/m3; water service EUR 2/m3; deionisation electricity 0.005 MJ/kg; factory-equivalent construction cost EUR 1,000,000; pallet wood mass 25 kg/item; steel/copper drawing electricity 1/0.5 MJ/kg; glass tempering heat 1 MJ/kg; front/back silver paste 85/70% precious metal and aluminium paste 75% aluminium with chemical binder making up the balance; and disclosed treatment-class, recovery and geographic proxies. These coefficients are demonstration assumptions, not observed prices, recipes, technical defaults or measurements."^^xsd:string ;
  ps:hasLimitation "DEMONSTRATION INVENTORY AND STUDY DRAFT, classified NotEFCompliant. All 42 activities, 466 exchanges and 202 elementary exchanges are retained. Native publication FlowType/source-dataset relationships resolve 89 suppliers; input and output quantities remain separate. Twenty-nine proxy activities and their 62 exchanges are assumptions, not measured company data. The BONSAI background contribution is available, while 191 elementary exchanges remain unresolved for direct EF 3.1 climate characterisation. BONSAI v2.1.6 method equivalence and foreground/background overlap are not established. No summed full footprint, complete LCIAResult, uncertainty propagation, independent verification or PEF compliance is asserted."^^xsd:string ;
  ps:biodiversityRelevance "No biodiversity assessment is performed. Source land-use/biodiversity inventory and spatial ecological context are insufficient; no zero-biodiversity-impact claim is made."^^xsd:string .

<https://w3id.org/cerise-see/examples/pv-lci#functional-unit> a ps:FunctionalUnit ;
  ps:whatProvided "Single-crystalline silicon photovoltaic panel at the Chinese factory gate"^^xsd:string ;
  ps:howWellProvided "Manufacturing declared unit of 1 m2 panel area. The production inventory contains no verified rated electrical performance, location-specific yield or electricity-generation service."^^xsd:string ;
  ps:howMuchProvided [ a om:Measure ; om:hasUnit <https://w3id.org/mintjesba/pefdpp/ef31-units#SquareMetre> ; om:hasNumericalValue "1"^^xsd:decimal ] ;
  ps:howLongProvided [ a om:Measure ; om:hasUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/year> ; om:hasNumericalValue "30"^^xsd:decimal ] ;
  ps:hasReferenceFlow <https://w3id.org/cerise-see/examples/pv-lci#flow-x-panel-cn-2> ;
  ps:RFtoFUConversion "1"^^xsd:double ;
  ps:notCoveredAspect "This is an area-based manufacturing declared unit, not 1 kWh of electricity. Thirty years is an explicit reference service-life assumption for mature PV modules from IEA PVPS Methodology Guidelines (2020), section 3.1.1: https://iea-pvps.org/wp-content/uploads/2020/07/IEA_Task12_LCA_Guidelines.pdf . It is contextual information only, not a duration supplied by the workbook. No annualisation, multiplication by 30, operating yield, degradation, replacement or use-phase burden is included. One reference output of 1 m2 is required once; RF-to-FU conversion is 1. To request 2 m2, set how-much to 2 and RF-to-FU quantity to 2. The tool does not automatically derive this conversion from the how-much field."^^xsd:string .

<https://w3id.org/cerise-see/examples/pv-lci#system-boundary> a ps:SystemBoundary ;
  ps:hasBoundaryType <https://w3id.org/mintjesba/pefdpp/pefstudy#CradleToGate> ;
  ps:cutOffCriteria "No source exchange rows removed. All 404 workbook records are represented and the original weighted silicon supply mix is retained. Additional scenario proxy details are limited to the disclosed assumptions; no unverified zero-impact supplier is introduced."^^xsd:string ;
  ps:hasJustification "The declared cradle-to-gate inventory scope covers 13 original manufacturing worksheets from metallurgical silicon through panel assembly, plus 29 explicitly assumed candidate supplier inventories. Manufacturing waste-treatment services do not represent end of life of the finished panel. Activity membership and lifecycle-stage assignment are preserved using ActivityLink. Source references retain the documented supply lineage without executable FlowLinks. Exact FlowType and source-dataset relationships support demand propagation without additional connection vocabulary."^^xsd:string ;
  ps:excludesActivity "Installation, mounting, external inverters/balance of system, operation, lifetime electricity generation, maintenance, replacements, final-product distribution and finished-panel end of life. Proxy-specific omissions are disclosed in each added activity note."^^xsd:string ;
  ps:exclusionJustification "These activities are not present in the manufacturing workbook. The model supports production-inventory reuse and data-structure testing only; a full system or electricity-service assessment requires additional foreground data and resolved background links."^^xsd:string .

