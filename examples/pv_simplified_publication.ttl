<https://w3id.org/cerise-see/examples/pv-lci#pef-study> a ps:PEFStudy ;
  dcterms:title "Selected PV inputs — demonstration only, not a full panel footprint"@en ;
  ps:hasGoal <https://w3id.org/cerise-see/examples/pv-lci#goal> ;
  ps:hasScope <https://w3id.org/cerise-see/examples/pv-lci#scope> ;
  ps:hasProductSystem <https://w3id.org/cerise-see/examples/pv-lci#product-system> .

<https://w3id.org/cerise-see/examples/pv-lci#goal> a ps:Goal ;
  ps:intendedApplication "Test ontology-based PV inventory exchange and connected activity scaling in the CE-RISE calculator."^^xsd:string ;
  ps:decisionContext "Research demonstration; not a verified product footprint or comparative assertion."^^xsd:string ;
  ps:commissioner <https://w3id.org/cerise-see/examples/pv-lci#commissioner> ;
  ps:verifier <https://w3id.org/cerise-see/examples/pv-lci#verifier> .

<https://w3id.org/cerise-see/examples/pv-lci#commissioner> a foaf:Agent ; foaf:name "CE-RISE research demonstration" .
<https://w3id.org/cerise-see/examples/pv-lci#verifier> a foaf:Agent ; foaf:name "Not independently verified" .

<https://w3id.org/cerise-see/examples/pv-lci#scope> a ps:Scope ;
  ps:hasFunctionalUnit <https://w3id.org/cerise-see/examples/pv-lci#functional-unit> ;
  ps:hasSystemBoundary <https://w3id.org/cerise-see/examples/pv-lci#system-boundary> ;
  ps:includesImpactCategory <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#Acidification>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#ClimateChange>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#EcoToxicityFreshwater>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#EutrophicationMarine>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#EutrophicationFreshwater>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#EutrophicationTerrestrial>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#HumanToxicityCancer>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#HumanToxicityNonCancer>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#IonisingRadiationHumanHealth>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#LandUse>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#OzoneDepletion>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#ParticulateMatter>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#PhotochemicalOzoneFormationHumanHealth>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#ResourceUseFossils>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#ResourceUseMineralsAndMetals>, <https://w3id.org/mintjesba/pefdpp/skos/ef31-impactcategories#WaterUse> ;
  ps:hasAssumption "Source quantities are unchanged. China electricity uses the broad BONSAI electricity market. Glass, aluminium, copper and paper use broad BONSAI sector proxies in Germany for RER source inputs. No silicon-to-wafer mass or area conversion was invented. The wafer-to-cell and cell-to-panel quantities are taken directly from the source inventory."^^xsd:string ;
  ps:hasLimitation "PARTIAL INVENTORY ONLY: 9 background input rows and 2 internal connections in 3 activities. Excludes silicon production, other process inputs, direct elementary emissions, transport, waste treatment, use and end of life. The displayed climate value is only the contribution of these selected input rows, not a PV panel footprint. Full source inventory is retained in 02_PV_FULL_inventory_publication.ttl; the expanded demonstration adds explicitly assumed suppliers. The mandatory 1-year duration is an editor placeholder and has no annualisation meaning."^^xsd:string .

<https://w3id.org/cerise-see/examples/pv-lci#functional-unit> a ps:FunctionalUnit ;
  ps:whatProvided "1 square metre of single-crystalline silicon photovoltaic panel at the factory gate"^^xsd:string ;
  ps:howWellProvided "Inventory reference area only; electrical performance and lifetime electricity generation are not assessed."^^xsd:string ;
  ps:howMuchProvided [ a om:Measure ; om:hasUnit <https://w3id.org/mintjesba/pefdpp/ef31-units#SquareMetre> ; om:hasNumericalValue "1"^^xsd:decimal ] ;
  ps:howLongProvided [ a om:Measure ; om:hasUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/year> ; om:hasNumericalValue "1"^^xsd:decimal ] ;
  ps:hasReferenceFlow <https://w3id.org/cerise-see/examples/pv-lci#flow-x-panel-cn-2> ;
  ps:RFtoFUConversion "1"^^xsd:double ;
  ps:notCoveredAspect "The duration of 1 year is a mandatory editor placeholder only. This production inventory is not annualised and does not model operation or lifetime generation."^^xsd:string .

<https://w3id.org/cerise-see/examples/pv-lci#system-boundary> a ps:SystemBoundary ;
  ps:hasBoundaryType <https://w3id.org/mintjesba/pefdpp/pefstudy#CradleToGate> ;
  ps:cutOffCriteria "Selected-input demonstration: no claim of complete mass or environmental coverage."^^xsd:string ;
  ps:hasJustification "Shows data reuse and quantity propagation from wafer production through cell production to panel assembly using only the selected source rows."^^xsd:string ;
  ps:excludesActivity "Use, lifetime electricity generation, installation and end-of-life activities."^^xsd:string ;
  ps:exclusionJustification "Not represented in this production inventory example."^^xsd:string .

